# ── Meta API Credentials ─────────────────────────────────────
# Get these from: https://developers.facebook.com/apps/
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_long_lived_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_numeric    # e.g. 123456789 (WITHOUT act_ prefix)
META_PAGE_ID=your_facebook_page_id_here           # Required for ad creatives

# ── Anthropic Claude AI (optional  -  for AI ad copy generation) ─
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Email Alerts via SMTP (optional) ─────────────────────────
# For Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
ALERT_EMAIL=alerts@yourdomain.com

# ── Brand Defaults (used in AI copy generation) ───────────────
BRAND_NAME=Your Brand Name
DEFAULT_LANDING_URL=https://yourdomain.com

# ── Optimization Thresholds (optional  -  overrides config.py) ──
# MIN_ROAS_THRESHOLD=1.5
# MAX_CPA_THRESHOLD=25.0
# MAX_FREQUENCY=4.0

# ── Database & Logging ────────────────────────────────────────
DB_PATH=meta_ads.db
LOG_FILE=automation.log
